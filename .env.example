# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# PRD ghi mọi lời gọi model đi qua OpenRouter. OPENAI_API_KEY còn đây vì
# src/services/llm.py hiện vẫn gọi OpenAI trực tiếp — đó là OD-03 chưa chốt.
OPENROUTER_API_KEY=
# Nhiều key phân cách bằng dấu phẩy; ưu tiên secret manager ở production.
# OPENROUTER_API_KEYS=sk-or-v1-key-a,sk-or-v1-key-b,sk-or-v1-key-c
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=llama-3.1-8b-instant
LLM_PROVIDERS=openrouter,groq
# Model chat. Đổi model thì sửa ở đây, không sửa trong code.
# Slug lấy đúng theo https://openrouter.ai/api/v1/models, sai một ký tự là 404.
MODEL_NAME=inclusionai/ling-3.0-tiny:free
# Bắt buộc bật khi MODEL_NAME thuộc dòng gpt-5.6: các model đó từ chối
# function tool trên /v1/chat/completions, chỉ chạy qua Responses API.
# Không ảnh hưởng openrouter/groq.
LLM_USE_RESPONSES_API=false
# openrouter hoặc openai. TODO(OD-03) chốt xong thì bỏ nhánh openai.
LLM_PROVIDER=openrouter
# Capability-aware routing is off until candidate tool smoke tests pass.
LLM_ROUTING_ENABLED=false
SMALL_TALK_CANDIDATES=openrouter:inclusionai/ling-3.0-tiny:free,groq:llama-3.1-8b-instant
WORK_TOOL_CANDIDATES=openrouter:inclusionai/ling-3.0-tiny:free,groq:llama-3.1-8b-instant
WORK_RESPONSE_CANDIDATES=openrouter:inclusionai/ling-3.0-tiny:free,groq:llama-3.1-8b-instant
PAID_FALLBACK_ENABLED=false
LLM_CANDIDATE_MAX_ATTEMPTS=1
# Nhiệt độ của lượt chọn công cụ. Lượt đó không viết văn, để 0 cho cùng một câu
# hỏi luôn ra cùng một quyết định tra nguồn. Lượt viết câu trả lời vẫn dùng
# LLM_TEMPERATURE như cũ.
LLM_TOOL_TEMPERATURE=0.0
# Trần thời gian cho một lời gọi model. Không có trần thì provider treo sẽ giữ
# luôn cả lượt chat và chuỗi failover không bao giờ được chạy tới.
LLM_REQUEST_TIMEOUT_SECONDS=30
# Ngân sách ngữ cảnh của vòng agent: giữ bao nhiêu observation gần nhất và tối
# đa bao nhiêu ký tự. Không chặn thì prompt phình theo số vòng tra nguồn.
AGENT_MAX_OBSERVATIONS_IN_CONTEXT=8
AGENT_CONTEXT_MAX_CHARS=12000
# Nhúng chunk. Đổi model là phải nhúng lại toàn bộ vì pgvector khoá số chiều
# theo cột; scripts/discord/embed_chunks.py tự dò số chiều rồi chỉnh cột.
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_BATCH_SIZE=32
# Trần thời gian cho một lời gọi nhúng. Trước để 60s cứng nên một lượt chat có
# thể đứng cả phút; nhúng chậm hơn ngần này thì thà báo không tra được.
EMBEDDING_TIMEOUT_SECONDS=8

# Truy hồi memory dài hạn (ADR-006). Nhánh vector chỉ chạy trên PostgreSQL có
# extension vector; tắt cờ này là đường rollback, hệ thống quay về khớp từ khoá.
MEMORY_SEMANTIC_RECALL_ENABLED=true
MEMORY_EMBEDDING_BATCH_LIMIT=16

OPENAI_API_KEY=
GOOGLE_SHEET_EXTRACTION_MODEL=gpt-4o-mini
# OpenRouter (OpenAI-compatible; preferred for local LLM calls)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-4o-mini
MOCK_LLM=false

# Optional XLM-R email classifier. Keep the token in the runtime secret store.
HF_MAIL_FILTER_ENABLED=false
HF_MAIL_FILTER_TOKEN=
HF_MAIL_FILTER_MODEL=DungND1107/modaiy_vin
HF_MAIL_FILTER_ENDPOINT=
HF_MAIL_FILTER_TIMEOUT_SECONDS=8
HF_MAIL_FILTER_MAX_CHARS=6000
HF_MAIL_FILTER_MIN_CONFIDENCE=0.80
# Override if the trained model uses a different label convention.
HF_MAIL_FILTER_KEEP_LABELS=LABEL_1,keep,relevant,actionable,important,positive
HF_MAIL_FILTER_DROP_LABELS=LABEL_0,drop,irrelevant,spam,noise,negative
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Tavily (tìm kiếm web) ----
# one-page-brief ghi "không làm tìm kiếm toàn mạng" trong sáu tuần, nên cờ này
# mặc định false. Chỉ bật cho thử nghiệm nội bộ, tới khi có ADR chốt.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=tvly-your-key-here
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=5
# basic rẻ và nhanh; advanced tốn credit hơn, chỉ dùng khi basic ra kết quả kém.
TAVILY_SEARCH_DEPTH=basic

# ---- Database ----
# docker-compose.yml có service "db" (Postgres) — chạy `docker compose up -d`
# tự dùng POSTGRES_* dưới đây để tạo DATABASE_URL bên trong network docker.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ai20k
# Cổng phía máy thật. Đặt khác 5432 nếu máy bạn đã có Postgres khác chiếm cổng đó.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://app:app@localhost:5433/ai20k
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- MinIO object storage ----
# Chạy local bằng `docker compose up -d minio`. Backend chạy ngoài Docker dùng
# localhost; backend chạy trong Compose cần MINIO_ENDPOINT=minio:9000.
MINIO_ENDPOINT=localhost:9000
MINIO_PRESIGN_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=app-objects
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_SECONDS=900

# ---- Redis (rate limiting) ----
# Chạy local bằng `docker compose up -d redis`. Backend chạy ngoài Docker dùng
# localhost; backend chạy trong Compose cần REDIS_URL=redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# ---- Hạn mức Sync (capacity guards) ----
# Số nguồn tối đa trong MỘT lần Sync. FE đọc lại qua GET /runs/limits để chặn
# ngay tại chỗ tick nguồn, nên đổi ở đây là UI đổi theo, không cần build lại.
MAX_SYNC_SOURCES=10
MAX_SYNC_RANGE_DAYS=31
# Trần run đang chạy của TOÀN hệ thống, đồng thời là số consumer loop mà
# src/worker.py spawn. Đặt thấp là user thứ N+1 ăn 429 "Hệ thống đang bận".
MAX_CONCURRENT_RUNS=10
# Trần run đồng thời của MỘT user. Để 1 thì bấm Sync lần hai khi lần một chưa
# xong sẽ bị từ chối — đúng ý đồ, tránh hai run ghi đè nhau.
MAX_RUNS_PER_USER=1

# ---- Auto-sync nền (ADR-011) ----
# Mặc định TẮT. Bật là hệ thống tự gọi API nguồn của người dùng khi họ không
# ngồi trước máy — thay đổi material về privacy, chỉ bật sau khi ADR-011 được
# duyệt. Run tự động chỉ dùng lại đúng bộ nguồn user đã tự chọn ở lần Sync
# thành công gần nhất, không bao giờ tự thêm nguồn mới.
AUTO_SYNC_ENABLED=false
AUTO_SYNC_INTERVAL_MINUTES=180
AUTO_SYNC_RANGE_HOURS=24
AUTO_SYNC_POLL_SECONDS=300
AUTO_SYNC_MAX_USERS_PER_TICK=20

# ---- Làm mới bộ nhớ đệm lịch ở nền (FR-102) ----
# Mặc định TẮT cùng lý do với AUTO_SYNC_ENABLED: hệ thống gọi API Google khi
# người dùng không ngồi trước máy. Nhẹ hơn auto-sync nhiều vì vòng này không
# tạo Run và không chạy LLM — nó chỉ đồng bộ tăng dần bằng syncToken đã lưu.
# Bật lên thì lịch bị dời giờ hoặc bị huỷ sẽ sinh thông báo calendar_changed
# thay vì chỉ cập nhật im lặng khi người dùng tự mở trang lịch.
CALENDAR_AUTO_REFRESH_ENABLED=false
CALENDAR_AUTO_REFRESH_INTERVAL_MINUTES=30
CALENDAR_AUTO_REFRESH_POLL_SECONDS=300
CALENDAR_AUTO_REFRESH_MAX_USERS_PER_TICK=20

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Múi giờ agent dùng khi nói "hôm nay", "còn mấy ngày". Tên theo IANA.
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---- Lịch chương trình (ADR-008) ----
# Khóa đang phục vụ; tool program_schedule chỉ đọc đúng cohort này.
PROGRAM_COHORT_SLUG=cohort-iii
# Feed ICS của ban tổ chức, dùng cho scripts/import_program_calendar.py.
# URL thật chứa token cá nhân — điền ở .env của máy chạy job, KHÔNG commit.
PHOENIX_ICS_FEED_URL=
# Vòng nhập lịch nền trong worker. Mặc định TẮT — bật là hệ thống tự gọi ra
# ngoài theo nhịp. Feed khai REFRESH-INTERVAL:PT1H nên quét dày hơn 60 phút là
# gọi thừa.
PROGRAM_CALENDAR_AUTO_IMPORT_ENABLED=false
PROGRAM_CALENDAR_IMPORT_INTERVAL_MINUTES=60

# ---- LangSmith (AI Logs — Deliverable #4) ----
# Tên LANGCHAIN_* là biến cũ, SDK vẫn đọc. Production dùng tên LANGSMITH_* mới
# (xem .env.prod.example) và cùng key đó được Grafana dùng lại cho dashboard
# "P-004 · LangSmith AI traces". Đừng khai cả hai bộ tên trong cùng một file.
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true
LANGSMITH_PII_REDACTION_ENABLED=true
# Bắt buộc khi tracing + redaction bật; dùng secret ngẫu nhiên, không commit.
LANGSMITH_PII_SALT=
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (giảng viên cấp) ----
# Key thật lấy từ giảng viên, chỉ điền vào .env cục bộ. Không commit vào file
# mẫu này — .env.example nằm trong repo nên mọi giá trị ở đây là công khai.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Connections (kết nối Discord/Gmail/Telegram) ----
# Bắt buộc để build redirect_uri gửi cho từng provider — phải là domain HTTPS
# công khai ở production, đăng ký y hệt trên dev console của từng bên.
APP_PUBLIC_URL=http://localhost:8000
WEB_APP_PUBLIC_URL=http://localhost:5173
# Deep-link callback chính xác của app Expo native; không thay bằng origin/web URL.
MOBILE_APP_REDIRECT_URI=mondaiy://auth/google
# iOS bundle ID đã bật Sign in with Apple trong Apple Developer.
APPLE_CLIENT_ID=com.mondaiy.product
# Apple Developer API credentials dùng để đổi authorization code lấy refresh
# token và revoke token khi user xóa tài khoản. Không commit private key.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Ký state token của vòng connect OAuth VÀ ký JWT access/refresh token (đăng
# ký/đăng nhập) — chuỗi ngẫu nhiên dài, KHÔNG dùng giá trị mẫu.
APP_SECRET_KEY=
# Fernet key (base64, 32 byte) mã hoá token đã kết nối trước khi lưu DB.
# Tạo bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- SMTP (email đặt lại mật khẩu) ----
# Để trống SMTP_HOST thì backend chỉ log link đặt lại mật khẩu ra console thay
# vì gửi mail thật — dev/pilot chạy được ngay không cần secret. Điền đủ để bật
# gửi mail thật (vd. Gmail SMTP dùng App Password, hoặc Resend/SendGrid SMTP relay).
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@mondaiy.local
SMTP_FROM_NAME=AI Program Navigator

# Discord Developer Portal > OAuth2 — redirect URI đăng ký:
# ${APP_PUBLIC_URL}/api/v1/connections/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token — chỉ dùng cho spike đọc raw message (scripts/discord_fetch_raw.py).
# OAuth2 user token không đọc được nội dung kênh. Bot cần bật Message Content
# Intent, nếu không thì trường content trả về rỗng.
DISCORD_BOT_TOKEN=

# Google Cloud Console > OAuth consent screen + Credentials — redirect URI:
# ${APP_PUBLIC_URL}/api/v1/connections/gmail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional AnythingLLM-compatible Gmail Apps Script bridge (read-only).
# Keep disabled unless the endpoint is a single-user deployment and the user
# id below is the only authenticated app user allowed to read it.
ANYTHINGLLM_GMAIL_BRIDGE_ENABLED=false
ANYTHINGLLM_GMAIL_BRIDGE_URL=
ANYTHINGLLM_GMAIL_BRIDGE_API_KEY=
ANYTHINGLLM_GMAIL_BRIDGE_USER_ID=
ANYTHINGLLM_GMAIL_BRIDGE_TIMEOUT_SECONDS=8
ANYTHINGLLM_GMAIL_BRIDGE_MAX_RESULTS=20

# Azure Portal (Entra ID) > App registrations — redirect URI đăng ký:
# ${APP_PUBLIC_URL}/api/v1/connections/outlook/callback
# ADR-013 — App Registration riêng, KHÔNG dùng chung credential với Google.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# BotFather — không có OAuth2 chuẩn, dùng Telegram Login Widget.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secret riêng truyền cho Telegram setWebhook; không dùng lại bot token.
TELEGRAM_WEBHOOK_SECRET=
# Chỉ bật sau khi webhook, consent copy và liên kết tài khoản đã kiểm tra.
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_DELIVERY_POLL_SECONDS=30

# ---- Web Push (kênh giao thông báo thứ ba) ----
# Mặc định TẮT, cùng lý do với TELEGRAM_DELIVERY_ENABLED: bật là hệ thống đẩy
# thông báo tới máy người dùng khi họ không mở ứng dụng. Chỉ bật sau khi môi
# trường đã có cặp khoá VAPID thật và đã kiểm tra luồng đăng ký trên trình duyệt.
WEB_PUSH_ENABLED=false
# Sinh cặp khoá bằng: python3 scripts/generate_vapid_keys.py
# Khoá công khai được trả cho trình duyệt qua GET /push/public-key nên không
# phải bí mật. Khoá riêng thì là bí mật thật — điền vào .env cục bộ hoặc secret
# manager, KHÔNG điền giá trị thật vào file mẫu này.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Địa chỉ liên hệ gửi kèm mỗi lời gọi để push service báo lại khi ta gửi sai.
# Chuẩn VAPID đòi dạng mailto: hoặc URL.
VAPID_SUBJECT=mailto:admin@example.com
# Nhịp quét reminder tới hạn của kênh này.
WEB_PUSH_POLL_SECONDS=30

# Cho /chat tìm không giới hạn phạm vi. Chỉ bật khi demo nội bộ, vì endpoint đó
# chưa xác thực người dùng. Môi trường thật phải để false.
DEMO_UNSCOPED_SEARCH=false

# Speech-to-Text (FPT marketplace, OpenAI-compatible)
# Lay key tai marketplace roi dien vao .env, KHONG dien vao file nay.
# FPT Cloud marketplace: MỘT key cho cả STT (whisper) và embedding
# (Vietnamese_Embedding). Thay cho STT_API_KEY/STT_BASE_URL cũ.
FPT_API_KEY=
FPT_BASE_URL=https://mkp-api.fptcloud.com
FPT_EMBEDDING_MODEL=Vietnamese_Embedding
# openrouter (mặc định, hiện 402 vì hết credit) | fpt
EMBEDDING_PROVIDER=openrouter
STT_MODEL=whisper-large-v3-turbo
# De rong = auto-detect. Ghim "vi" vi bo trong khien model tu dich sang tieng Anh voi webm.
STT_LANGUAGE=vi

# Han muc ghi am moi ngay cho tai khoan thuong (phut). Admin khong bi gioi han.
# Dat 0 = khoa han tinh nang ghi am voi nguoi dung thuong.
RECORDING_QUOTA_DAILY_MINUTES=15

# https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
