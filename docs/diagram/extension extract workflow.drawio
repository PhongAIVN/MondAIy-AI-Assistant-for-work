        <mxCell id="p2e-f2a" edge="1" parent="1" source="p2n-f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="p2n-f3a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="Model SVM rẻ tự học từ vài trăm mẫu đã gán nhãn sẵn (thay cho LLM đắt)" Model="SVM (Support Vector Machine) — huấn luyện trên vector đặc trưng TF-IDF / N-gram từ tập câu mẫu việc-cần-làm đã gán nhãn, chạy local cực nhanh và không tốn chi phí token LLM" Explain="Sử dụng thuật toán học máy SVM (Support Vector Machine) để phân loại câu việc-cần-làm thay thế cho LLM đắt đỏ khi đã qua các bước lọc cơ bản." id="p2n-f3b">
