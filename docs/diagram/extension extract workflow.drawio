        <object label="Lọc mềm qua LLM (đắt, chính xác cao)" Model="OpenRouter (mặc định openrouter:inclusionai/ling-3.0-tiny:free, fallback groq:llama-3.1-8b-instant — xem src/config.py work_response_candidates, không phải OpenAI)" id="p2n-f3a">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="80" width="190" x="265" y="890" as="geometry" />
