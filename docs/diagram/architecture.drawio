        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="1. fetch&#xa;&lt;font style=&quot;font-size:9px&quot;&gt;gọi song song 3 nguồn&#xa;IN: sources[] + time_range&#xa;OUT: raw_message[] {platform, content, sent_at}&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="180" x="285" y="340" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="2. normalize&#xa;&lt;font style=&quot;font-size:9px&quot;&gt;làm sạch, đổi múi giờ&#xa;IN: raw_message&#xa;OUT: normalized_message {content_clean, sent_at_local, source_url}&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="180" x="495" y="340" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="3. filter&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Luật - loại bỏ tin nhắn thừa&lt;br&gt;giữ: thời gian/việc/nhờ vả/@mention/DM&lt;br&gt;loại: quá ngắn/tự gửi/hệ thống/sticker&lt;br&gt;IN: normalized_message&lt;br&gt;OUT: filtered_message {keep, score, matched_signals}&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="180" x="705" y="340" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="4. make_batches&#xa;&lt;font style=&quot;font-size:9px&quot;&gt;cắt lô 15 tin + ngữ cảnh&#xa;IN: filtered_message[] (keep=true) + tin ngữ cảnh&#xa;OUT: batch {batch_id, messages[]}&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="180" x="915" y="340" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" value="5. extract_batch&#xa;&lt;font style=&quot;font-size:9px&quot;&gt;LLM đọc 15 tin -&amp;gt; JSON&#xa;IN: batch&#xa;OUT: extracted_item[] {title, time_phrase, assignee_hint, quote, confidence}&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="285" y="520" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="6. resolve&#xa;&lt;font style=&quot;font-size:9px&quot;&gt;tính ngày giờ + danh tính&#xa;IN: extracted_item + identity table + tz&#xa;OUT: resolved_item {deadline_normalized, assignee, keep}&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="495" y="520" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" value="7. cluster&#xa;&lt;font style=&quot;font-size:9px&quot;&gt;gộp trùng xuyên nền tảng&#xa;IN: resolved_item[]&#xa;OUT: cluster {cluster_id, item_ids[], deadline_normalized, source_count}&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="705" y="520" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" value="8. reduce&#xa;&lt;font style=&quot;font-size:9px&quot;&gt;LLM viết tóm tắt + ưu tiên&#xa;IN: cluster[] rút gọn (~26 dòng)&#xa;OUT: brief {summary, top_priority[], schedule_conflicts[]}&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="915" y="520" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="9. persist&#xa;&lt;font style=&quot;font-size:9px&quot;&gt;lưu PostgreSQL, đẩy SSE kết quả&#xa;IN: cluster[] + brief&#xa;OUT: {briefing_id, result_url}&#xa;Calendar handoff (template/.ics) là API riêng, chạy sau khi user Xác nhận&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="180" x="915" y="660" as="geometry" />
