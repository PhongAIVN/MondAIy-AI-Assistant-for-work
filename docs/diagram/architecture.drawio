  <diagram name="2. Phễu 4 tầng" id="page2">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="Phễu 4 tầng - 1.680 tin nhắn thành 26 việc" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="in" value="1.680 tin nhắn thô&#xa;&lt;font style=&quot;font-size:11px&quot;&gt;Discord + Telegram + Gmail, 3 ngày&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t1b" value="TẦNG 1 - LỌC THÔ&#xa;&lt;font style=&quot;font-size:11px&quot;&gt;Mã thuần. 0 đồng. 0,1 giây.&#xa;Tìm từ khóa: mai, deadline, nhớ, @tên, 8h...&#xa;Bỏ: ok, haha, sticker, newsletter, tin của chính mình&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="190" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t2b" value="TẦNG 2 - HIỂU (LLM)&#xa;&lt;font style=&quot;font-size:11px&quot;&gt;14 lô x 15 tin, chạy SONG SONG.&#xa;Mỗi lần LLM chỉ nhìn 15 tin -&amp;gt; bắt được ~100%.&#xa;Điền vào biểu mẫu có cấu trúc dữ liệu cố định.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="330" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t3b" value="TẦNG 3 - DỌN &amp;amp; GỘP&#xa;&lt;font style=&quot;font-size:11px&quot;&gt;Mã thuần. 0 đồng.&#xa;Tính ngày giờ thật - bỏ việc người khác&#xa;Gộp trùng xuyên nền tảng (khóa cứng / so khớp mờ / vector nhúng)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="470" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="t4b" value="TẦNG 4 - VIẾT (LLM)&#xa;&lt;font style=&quot;font-size:11px&quot;&gt;1 lần gọi duy nhất, ~3.000 token.&#xa;KHÔNG nhìn tin nhắn thô - chỉ đọc 26 dòng đã gọn.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="610" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="out" value="Tóm tắt + 26 việc + Cảnh báo trùng lịch&#xa;&lt;font style=&quot;font-size:11px&quot;&gt;mỗi việc kèm bằng chứng + liên kết tin nhắn gốc&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="740" width="400" height="60" as="geometry" />
        </mxCell>
