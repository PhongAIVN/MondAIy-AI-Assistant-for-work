        <mxCell id="lg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#9673a6;" value="LangGraph - quy trình xử lý" vertex="1">
