        <mxCell id="rcLabel" parent="1" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#B8960C;align=left;" value="RULE CONFIG  (cross-cutting — cấu hình được, không hard-code)" vertex="1">
          <mxGeometry height="24" width="560" x="1400" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="rc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E0;strokeColor=#B8960C;fontSize=11;fontFamily=Courier New;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="RULE_CONFIG&lt;br&gt;├── thresholds (giữ lại &gt;=35, fuzzy match &gt;=72%...)&lt;br&gt;├── scoring weights (action/deadline/urgency/&lt;br&gt;│&amp;#160;&amp;#160;&amp;#160;program/newsletter/automated...)&lt;br&gt;├── status mapping (theo từng project, vì status&lt;br&gt;│&amp;#160;&amp;#160;&amp;#160;tuỳ biến khác nhau)&lt;br&gt;├── priority mapping (Highest..Lowest -&gt; điểm)&lt;br&gt;├── action keywords&lt;br&gt;├── urgency keywords&lt;br&gt;├── deadline keywords&lt;br&gt;├── system-generated patterns&lt;br&gt;├── overlap_window (incremental sync)&lt;br&gt;└── grouping thresholds&lt;br&gt;&lt;br&gt;Có &lt;b&gt;rule_version&lt;/b&gt; — biết 1 decision được tạo ra&lt;br&gt;bởi phiên bản rule nào." vertex="1">
          <mxGeometry height="380" width="560" x="1400" y="1584" as="geometry" />
        </mxCell>
        <mxCell id="rcBracket" parent="1" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#B8960C;align=left;" value="áp dụng cho bước 3, 4, 5, 7&#xa;(Hard Filter / Rules / Scoring / Dedup-Group)" vertex="1">
          <mxGeometry height="34" width="560" x="1400" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="rcLink" edge="1" parent="1" source="rc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#B8960C;" target="st4label">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adLabel" parent="1" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#666666;align=left;" value="AUDIT / DEBUG  (cross-cutting — xuyên suốt bước 1-8)" vertex="1">
          <mxGeometry height="24" width="560" x="1400" y="2060" as="geometry" />
        </mxCell>
        <mxCell id="ad" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="Mỗi lần chạy (sync/run) ghi lại được:&lt;br&gt;&lt;br&gt;- Issue nào được fetch, kết quả ingest (SUCCESS/&lt;br&gt;  SYNC_FAILED/EMPTY_RESULT)&lt;br&gt;- Issue nào DROP / REVIEW / KEEP&lt;br&gt;- score + reasons[] + rule_version của từng issue&lt;br&gt;- candidate task nào gộp từ issue nào (references)&lt;br&gt;- sync/run ID, processing timestamp&lt;br&gt;&lt;br&gt;Mục tiêu: audit lại được toàn bộ quyết định của 1&lt;br&gt;lần đồng bộ mà không cần hỏi AI, không cần đọc code." vertex="1">
          <mxGeometry height="270" width="560" x="1490" y="2100" as="geometry" />
        </mxCell>
        <mxCell id="adLink" edge="1" parent="1" source="ad" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#666666;" target="st8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="jira-example" name="Ví dụ minh họa">
    <mxGraphModel dx="1667" dy="733" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="etitle" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;" value="Ví dụ: issue TO04-42 đi qua đủ 10 bước pipeline (rule-base)" vertex="1">
          <mxGeometry height="26" width="1100" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="uc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#7B4FBF;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;CURRENT USER CONTEXT&lt;/b&gt;&lt;br&gt;&lt;br&gt;account_id: acc-phong-01&lt;br&gt;timezone: Asia/Ho_Chi_Minh" vertex="1">
          <mxGeometry height="110" width="260" x="1330" y="16" as="geometry" />
        </mxCell>
        <mxCell id="ex1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;1. INGESTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;project=TO04&lt;br&gt;last_successful_sync_time&lt;br&gt;= 04/08 09:00 - overlap&lt;br&gt;window 10 phút&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;kết quả = SUCCESS&lt;br&gt;(không phải EMPTY_RESULT)&lt;br&gt;1 issue thô: TO04-42&lt;br&gt;(JSON gốc từ Jira API)" vertex="1">
          <mxGeometry height="240" width="270" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ex2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;2. NORMALIZATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;issue thô TO04-42 +&lt;br&gt;timezone (từ User Context)&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt; (schema chuẩn)&lt;br&gt;title: &amp;quot;Hoàn thành báo cáo&lt;br&gt;tuần 3&amp;quot;&lt;br&gt;assignee.account_id:&lt;br&gt;acc-phong-01&lt;br&gt;status_category: In Progress&lt;br&gt;resolution: null&lt;br&gt;priority: High&lt;br&gt;due_date (VN tz): 15/08/2026&lt;br&gt;-&gt; DUE_SOON&lt;br&gt;description: &amp;quot;...cần nộp&lt;br&gt;trước thứ Sáu.&amp;quot;" vertex="1">
          <mxGeometry height="340" width="270" x="330" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ex3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C0392B;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;3. HARD FILTER&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;status_category: In Progress&lt;br&gt;resolution: null&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;Không khớp điều kiện DROP&lt;br&gt;nào (status != Done, không&lt;br&gt;phải system-generated)&lt;br&gt;-&gt; KHÔNG bị DROP, đi tiếp" vertex="1">
          <mxGeometry height="240" width="270" x="620" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ex4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97A2B;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;4. JIRA + COMMON RULES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;issue đã qua Hard Filter +&lt;br&gt;account_id (từ User Context)&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt; (rule khớp)&lt;br&gt;HAS_ACTION (&amp;quot;hoàn thành&amp;quot;,&lt;br&gt;&amp;quot;cần&amp;quot;, &amp;quot;nộp&amp;quot;)&lt;br&gt;HAS_DEADLINE (&amp;quot;thứ Sáu&amp;quot;)&lt;br&gt;ASSIGNED_TO_CURRENT_USER&lt;br&gt;(assignee.account_id ==&lt;br&gt;acc-phong-01)&lt;br&gt;HIGH_PRIORITY (priority=High)&lt;br&gt;DUE_SOON" vertex="1">
          <mxGeometry height="320" width="270" x="910" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ex5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;5. SCORING&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;5 rule đã khớp ở bước 4&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;HAS_ACTION +25&lt;br&gt;HAS_DEADLINE +25&lt;br&gt;ASSIGNED_TO_CURRENT_USER +15&lt;br&gt;HIGH_PRIORITY +10&lt;br&gt;DUE_SOON +10&lt;br&gt;&lt;br&gt;score = 85 (&gt;= ngưỡng 35&lt;br&gt;mặc định)" vertex="1">
          <mxGeometry height="240" width="270" x="1200" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ex6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;6. EXTRACTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;issue TO04-42, score=85&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;title, assignee, deadline,&lt;br&gt;priority: lấy thẳng field đã&lt;br&gt;chuẩn hoá ở bước 2&lt;br&gt;evidence: &amp;quot;...cần nộp trước&lt;br&gt;thứ Sáu.&amp;quot; (câu khớp rule&lt;br&gt;action + deadline)" vertex="1">
          <mxGeometry height="440" width="270" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ex7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;7. DEDUP / GROUP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;issue TO04-42 đã extract&lt;br&gt;+ toàn bộ issue khác trong&lt;br&gt;đợt sync này&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;Dedup: issue_key duy nhất,&lt;br&gt;không trùng trang/lần chạy&lt;br&gt;Group: không issue nào khác&lt;br&gt;cùng epic/tiêu đề -&gt; 1&lt;br&gt;candidate task, references&lt;br&gt;= [TO04-42]" vertex="1">
          <mxGeometry height="440" width="270" x="330" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ex8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#7B4FBF;fontSize=10.5;fontFamily=Courier New;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;8. DECISION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;candidate task, score=85&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;{&lt;br&gt;&amp;#160;score: 85,&lt;br&gt;&amp;#160;decision: &amp;quot;KEEP&amp;quot;,&lt;br&gt;&amp;#160;reasons: [&amp;quot;HAS_ACTION&amp;quot;,&lt;br&gt;&amp;#160;&amp;#160;&amp;quot;HAS_DEADLINE&amp;quot;,&lt;br&gt;&amp;#160;&amp;#160;&amp;quot;ASSIGNED_TO_CURRENT_USER&amp;quot;,&lt;br&gt;&amp;#160;&amp;#160;&amp;quot;HIGH_PRIORITY&amp;quot;, &amp;quot;DUE_SOON&amp;quot;],&lt;br&gt;&amp;#160;rule_version: &amp;quot;jira-rules-v3&amp;quot;&lt;br&gt;}" vertex="1">
          <mxGeometry height="440" width="270" x="620" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ex9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F6E7;strokeColor=#4B8B3B;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;9. USER CONFIRMATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;candidate task, decision=KEEP&lt;br&gt;state: NEW&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;state -&gt; PENDING_CONFIRMATION&lt;br&gt;(hiện &amp;quot;Hoàn thành báo cáo&lt;br&gt;tuần 3&amp;quot; trong Công việc&lt;br&gt;của tôi)&lt;br&gt;User bấm Xác nhận&lt;br&gt;-&gt; state = CONFIRMED" vertex="1">
          <mxGeometry height="440" width="270" x="910" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ex10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F6E7;strokeColor=#4B8B3B;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;10. CALENDAR&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;task state = CONFIRMED&lt;br&gt;(P0 hiện tại: chỉ export .ics,&lt;br&gt;chưa tích hợp Calendar API)&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;state -&gt; &lt;b&gt;EXPORTED&lt;/b&gt; (không&lt;br&gt;phải CALENDAR_SYNCED — chưa&lt;br&gt;có event thật ở calendar&lt;br&gt;provider nào)&lt;br&gt;file .ics tải về&lt;br&gt;reference lưu: issue_key&lt;br&gt;= TO04-42" vertex="1">
