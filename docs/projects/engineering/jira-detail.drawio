        <mxCell id="ucLink2" edge="1" parent="1" source="uc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;strokeColor=#7B4FBF;fontSize=10;fontColor=#7B4FBF;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" target="st4a" value="account_id">
