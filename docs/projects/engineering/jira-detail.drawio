<mxfile host="Electron" agent="mondaiy" pages="2">
  <diagram id="jira-pipeline" name="Jira pipeline">
    <mxGraphModel dx="1071" dy="471" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="4200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="subnote" parent="1" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#888888;align=left;" value="Thiết kế chung cho nhiều nguồn (Email/Slack/GitHub sau này) — hiện chỉ triển khai Jira. Mọi số điểm/threshold trong diagram là GIÁ TRỊ MẶC ĐỊNH, cấu hình được (xem panel RULE CONFIG bên phải), không phải giá trị cố định." vertex="1">
          <mxGeometry height="34" width="1240" x="40" y="92" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#666666;align=left;" value="Đỏ = Hard Filter (loại chắc chắn)  |  Cam = Jira-specific rules  |  Xanh dương = Common rules / bước chuẩn  |  Tím = Decision (explainable)  |  Xanh lá = Output/trạng thái cuối  |  Vàng = Rule Config  |  Xám = Audit/Debug  |  Xanh nhạt viền tím = User Context" vertex="1">
          <mxGeometry height="46" width="700" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="src" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#3B5FA6;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="JIRA" vertex="1">
          <mxGeometry height="46" width="180" x="960" y="140" as="geometry" />
        </mxCell>
        <mxCell id="uc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#7B4FBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;CURRENT USER CONTEXT&lt;/b&gt;&lt;br&gt;(input cho pipeline, không phải 1 bước xử lý)&lt;br&gt;&lt;br&gt;- account_id (Jira accountId — ĐỊNH DANH DUY&lt;br&gt;  NHẤT, dùng để so khớp assigned_to_current_user)&lt;br&gt;- timezone (dùng để quy đổi due_date ở bước 2)&lt;br&gt;&lt;br&gt;Luôn dùng account_id để so khớp người dùng hiện&lt;br&gt;tại — KHÔNG dùng display name / email (trùng tên,&lt;br&gt;đổi email vẫn đúng account_id)." vertex="1">
          <mxGeometry height="230" width="300" x="40" y="620" as="geometry" />
        </mxCell>
        <mxCell id="st1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=11.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;1. INGESTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gọi Jira API (search/jql), phân trang bằng cursor token&lt;br&gt;&lt;br&gt;&lt;b&gt;Loại lỗi:&lt;/b&gt;&lt;br&gt;- Rate limit (HTTP 429), HTTP 5xx, timeout -&gt; RETRYABLE&lt;br&gt;- Lỗi xác thực / phân quyền (401/403) -&gt; NON-RETRYABLE&lt;br&gt;&lt;br&gt;&lt;b&gt;Kết quả 1 lần chạy ingest:&lt;/b&gt;&lt;br&gt;- SUCCESS -&gt; đưa dữ liệu vào pipeline (bước 2)&lt;br&gt;- retryable error -&gt; retry theo backoff, thử lại&lt;br&gt;- non-retryable error -&gt; SYNC_FAILED, dừng, ghi audit&lt;br&gt;- 0 issue trả về -&gt; EMPTY_RESULT (VẪN LÀ THÀNH CÔNG,&lt;br&gt;  chỉ là không có gì để xử lý tiếp — KHÁC SYNC_FAILED,&lt;br&gt;  không được gộp chung 2 khái niệm này)&lt;br&gt;&lt;br&gt;&lt;b&gt;Incremental sync:&lt;/b&gt;&lt;br&gt;- Lần đầu: lấy theo khoảng lịch sử (historical range)&lt;br&gt;- Lần sau: updated &gt;= last_successful_sync_time -&lt;br&gt;  overlap_window (vd 5-10 phút, tránh bỏ sót issue vừa&lt;br&gt;  đổi ngay lúc đồng bộ, cấu hình được)&lt;br&gt;- Checkpoint last_successful_sync_time CHỈ cập nhật&lt;br&gt;  sau khi cả lần đồng bộ = SUCCESS&lt;br&gt;&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; danh sách issue thô (JSON), có thể trùng&lt;br&gt;giữa các trang / các lần chạy" vertex="1">
          <mxGeometry height="480" width="560" x="780" y="220" as="geometry" />
        </mxCell>
        <mxCell id="st2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=11.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;2. NORMALIZATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chuẩn hoá issue thô về 1 schema nội bộ thống nhất —&lt;br&gt;mọi rule phía sau CHỈ chạy trên schema này, không&lt;br&gt;phụ thuộc trực tiếp response của Jira API:&lt;br&gt;&lt;br&gt;issue_id, issue_key, project, title, description,&lt;br&gt;assignee (kèm account_id), status, status_category,&lt;br&gt;resolution, priority, issue_type, due_date,&lt;br&gt;created_at, updated_at, url&lt;br&gt;&lt;br&gt;Due date -&gt; quy đổi theo timezone lấy từ CURRENT USER&lt;br&gt;CONTEXT (không hard-code UTC) -&gt; suy ra:&lt;br&gt;OVERDUE / DUE_TODAY / DUE_TOMORROW / DUE_SOON /&lt;br&gt;FUTURE / NO_DEADLINE" vertex="1">
          <mxGeometry height="300" width="560" x="780" y="750" as="geometry" />
        </mxCell>
        <mxCell id="st3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C0392B;fontSize=11.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;3. HARD FILTER&lt;/b&gt;  (chỉ loại khi CHẮC CHẮN, không tính điểm)&lt;br&gt;&lt;br&gt;- status_category = Done -&gt; DROP&lt;br&gt;- Sinh tự động / notification, KHÔNG có hành động -&gt; DROP&lt;br&gt;&lt;br&gt;- resolution != null NHƯNG status_category != Done&lt;br&gt;  -&gt; &lt;b&gt;KHÔNG tự DROP tuyệt đối.&lt;/b&gt; Đưa qua REVIEW hoặc&lt;br&gt;  trừ điểm nhẹ ở Scoring (cấu hình được) — có resolution&lt;br&gt;  nhưng trạng thái chưa đóng vẫn có thể cần xem lại&lt;br&gt;&lt;br&gt;&lt;b&gt;Ranh giới rõ với Scoring:&lt;/b&gt; Hard Filter = CHẮC CHẮN&lt;br&gt;loại (không thể là việc-cần-làm, không bàn cãi).&lt;br&gt;Scoring (bước 5) = tín hiệu / khả năng cần làm — mọi&lt;br&gt;trường hợp còn mơ hồ để Scoring quyết định, KHÔNG&lt;br&gt;loại cứng ở đây.&lt;br&gt;&lt;br&gt;Dùng status_category chuẩn Jira (To Do / In Progress /&lt;br&gt;Done) — KHÔNG hard-code theo tên status cụ thể, vì&lt;br&gt;mỗi project có thể custom tên status khác nhau." vertex="1">
          <mxGeometry height="400" width="560" x="780" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="st4label" parent="1" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#3B5FA6;align=center;" value="4. JIRA RULES  +  COMMON RULES  (tín hiệu đưa vào Scoring)" vertex="1">
          <mxGeometry height="24" width="900" x="600" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="st4a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97A2B;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;JIRA-SPECIFIC RULES&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Status: status_category (To Do / In Progress / Done)&lt;br&gt;- Resolution: resolution != null -&gt; tín hiệu &quot;có thể&lt;br&gt;  đã xử lý&quot;. KHÔNG tự DROP nếu status chưa Done —&lt;br&gt;  đánh dấu REVIEW hoặc trừ điểm nhẹ (cấu hình được)&lt;br&gt;- Assignee: assigned_to_current_user = so khớp&lt;br&gt;  assignee.account_id == CURRENT USER CONTEXT&lt;br&gt;  .account_id (SO ACCOUNT_ID, không dùng display&lt;br&gt;  name / email) — 3 trạng thái: assigned_to_current_user&lt;br&gt;  (+điểm) / assigned_to_other_user (không tính là việc&lt;br&gt;  của user) / unassigned (không cộng điểm assignee)&lt;br&gt;- Priority: Highest/High/Medium/Low/Lowest -&gt;&lt;br&gt;  map thành điểm (cấu hình được)&lt;br&gt;- Due date đã chuẩn hoá: OVERDUE/DUE_TODAY/&lt;br&gt;  DUE_TOMORROW/DUE_SOON -&gt; điểm khác nhau" vertex="1">
          <mxGeometry height="360" width="440" x="600" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="st4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#3B5FA6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;COMMON RULES&lt;/b&gt;  (dùng chung cho nguồn sau này)&lt;br&gt;&lt;br&gt;- Từ khoá hành động (action keyword)&lt;br&gt;- Từ khoá hạn chót (deadline keyword)&lt;br&gt;- Từ khoá khẩn cấp (urgency keyword)&lt;br&gt;- Liên quan chương trình (assignment/milestone...)&lt;br&gt;- Newsletter / quảng cáo -&gt; penalty&lt;br&gt;- Gửi tự động (no-reply...) -&gt; penalty&lt;br&gt;&lt;br&gt;&lt;b&gt;Ghi chú:&lt;/b&gt; rule thiết kế gốc cho email (người nhận&lt;br&gt;trực tiếp / CC / chưa đọc / đổi thread) KHÔNG áp dụng&lt;br&gt;được cho Jira — đã thay bằng Jira-Specific Rules bên&lt;br&gt;trái, không dùng nữa ở nguồn Jira." vertex="1">
          <mxGeometry height="360" width="440" x="1060" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="st5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=11.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;5. SCORING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chỉ chấm điểm issue đã QUA Hard Filter (chưa bị DROP)&lt;br&gt;Cộng/trừ theo tín hiệu đã khớp ở bước 4&lt;br&gt;&lt;br&gt;&lt;b&gt;Trọng số mặc định (giữ nguyên hiện tại — CONFIGURABLE,&lt;br&gt;không phải giá trị cố định):&lt;/b&gt;&lt;br&gt;- action keyword: +25&lt;br&gt;- deadline keyword: +25&lt;br&gt;- urgency keyword: +25&lt;br&gt;- program/milestone: +20&lt;br&gt;- newsletter: -40&lt;br&gt;- automated: -30&lt;br&gt;- priority (Highest..Lowest): map điểm riêng theo&lt;br&gt;  priority mapping trong RULE_CONFIG&lt;br&gt;- resolution != null nhưng chưa Done (từ bước 3): penalty nhẹ&lt;br&gt;&lt;br&gt;Ngưỡng giữ lại mặc định: điểm &gt;= 35 (CONFIGURABLE)&lt;br&gt;&lt;br&gt;&lt;b&gt;Output mỗi issue:&lt;/b&gt; {score, matched_rule_codes[]}" vertex="1">
          <mxGeometry height="360" width="560" x="780" y="2010" as="geometry" />
        </mxCell>
        <mxCell id="st6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=11.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;6. EXTRACTION&lt;/b&gt;  (rule nâng cao — vẫn KHÔNG AI)&lt;br&gt;&lt;br&gt;- title &lt;- summary (lấy thẳng, không xử lý)&lt;br&gt;- assignee &lt;- assignee (chuẩn hoá, kèm account_id)&lt;br&gt;- deadline &lt;- due_date đã chuẩn hoá&lt;br&gt;- priority &lt;- priority (chuẩn hoá)&lt;br&gt;- status &lt;- status_category (chuẩn hoá)&lt;br&gt;- evidence &lt;- câu/cụm từ trong description khớp rule&lt;br&gt;  action hoặc deadline ở bước 4; không câu nào khớp&lt;br&gt;  -&gt; fallback lấy summary làm evidence&lt;br&gt;&lt;br&gt;&quot;Tóm tắt cụm&quot; (khi group) = ghép các evidence theo&lt;br&gt;quy tắc cố định (concatenation), KHÔNG paraphrase" vertex="1">
          <mxGeometry height="280" width="560" x="780" y="2420" as="geometry" />
        </mxCell>
        <mxCell id="st7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=11.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;7. DEDUP / GROUP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dedup trước&lt;/b&gt; (issue trùng do fetch nhiều trang / nhiều&lt;br&gt;lần chạy) — ưu tiên theo thứ tự:&lt;br&gt;1. issue_id / issue_key&amp;#160;&amp;#160;2. canonical URL&amp;#160;&amp;#160;3. identifier khác&lt;br&gt;&lt;br&gt;&lt;b&gt;Group sau&lt;/b&gt; (các issue khác nhau cùng 1 việc) —&lt;br&gt;ưu tiên theo thứ tự:&lt;br&gt;1. Cùng issue key&amp;nbsp;&amp;nbsp;2. Cùng parent/epic&amp;nbsp;&amp;nbsp;3. Cùng URL liên kết&lt;br&gt;4. Cùng tiêu đề chuẩn hoá + assignee + thời gian liên quan&lt;br&gt;5. Fuzzy title similarity — CHỈ LÀ FALLBACK (72% mặc&lt;br&gt;   định, CONFIGURABLE FALLBACK THRESHOLD)&lt;br&gt;&lt;br&gt;&lt;b&gt;Quan trọng:&lt;/b&gt; Group CHỈ tạo ra 1 candidate task —&lt;br&gt;KHÔNG merge, KHÔNG xoá issue Jira nguồn. Candidate&lt;br&gt;task luôn giữ danh sách references (issue_key) tới&lt;br&gt;TẤT CẢ issue Jira đã gộp vào, để truy vết ngược được." vertex="1">
          <mxGeometry height="400" width="560" x="780" y="2750" as="geometry" />
        </mxCell>
        <mxCell id="st8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#7B4FBF;fontSize=11.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;8. DECISION&lt;/b&gt;  (explainable — không chỉ trả score)&lt;br&gt;&lt;br&gt;Mỗi candidate task sau xử lý có dạng:&lt;br&gt;{ score: 55, decision: &quot;KEEP&quot;,&lt;br&gt;&amp;#160;&amp;#160;reasons: [&quot;HAS_DEADLINE&quot;, &quot;ASSIGNED_TO_CURRENT_USER&quot;,&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&quot;ACTION_REQUIRED&quot;],&lt;br&gt;&amp;#160;&amp;#160;rule_version: &quot;jira-rules-v3&quot; }&lt;br&gt;&lt;br&gt;reason code deterministic, machine-readable — ví dụ:&lt;br&gt;HAS_ACTION · HAS_DEADLINE · URGENT ·&lt;br&gt;ASSIGNED_TO_CURRENT_USER · HIGH_PRIORITY ·&lt;br&gt;STATUS_DONE · SYSTEM_GENERATED · NO_ACTION_REQUIRED&lt;br&gt;&lt;br&gt;Decision: DROP / REVIEW / KEEP. rule_version đi kèm mọi&lt;br&gt;decision — đổi rule không làm mất khả năng giải thích&lt;br&gt;quyết định cũ (xem thêm RULE CONFIG, AUDIT/DEBUG)." vertex="1">
          <mxGeometry height="290" width="560" x="780" y="3190" as="geometry" />
        </mxCell>
        <mxCell id="dDrop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#888888;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;DROP&lt;/b&gt;&lt;br&gt;Loại bỏ, không hiện&lt;br&gt;cho user. Chỉ ghi&lt;br&gt;vào Audit/Debug." vertex="1">
          <mxGeometry height="90" width="170" x="780" y="3520" as="geometry" />
        </mxCell>
        <mxCell id="dReview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E0;strokeColor=#B8960C;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;REVIEW&lt;/b&gt;&lt;br&gt;Tín hiệu chưa chắc&lt;br&gt;chắn — vẫn hiện cho&lt;br&gt;user, gắn nhãn &quot;cần&lt;br&gt;xem lại&quot;." vertex="1">
          <mxGeometry height="90" width="170" x="980" y="3520" as="geometry" />
        </mxCell>
        <mxCell id="dKeep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F6E7;strokeColor=#4B8B3B;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;KEEP&lt;/b&gt;&lt;br&gt;Đủ điều kiện, có&lt;br&gt;reason rõ ràng —&lt;br&gt;hiện cho user bình&lt;br&gt;thường." vertex="1">
          <mxGeometry height="90" width="170" x="1180" y="3520" as="geometry" />
        </mxCell>
        <mxCell id="st9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F6E7;strokeColor=#4B8B3B;fontSize=11.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;9. USER CONFIRMATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Task hiện trong &quot;Công việc của tôi&quot; (KEEP/REVIEW)&lt;br&gt;&lt;br&gt;&lt;b&gt;State machine:&lt;/b&gt;&lt;br&gt;NEW -&gt; PENDING_CONFIRMATION -&gt; CONFIRMED -&gt; (bước 10)&lt;br&gt;PENDING_CONFIRMATION -&gt; SKIPPED (user bỏ qua)&lt;br&gt;PENDING_CONFIRMATION -&gt; EXPIRED (quá hạn xử lý, cấu hình được)&lt;br&gt;Bất kỳ trạng thái nào -&gt; UPDATED khi issue Jira gốc&lt;br&gt;đổi (deadline/title/assignee/status) -&gt; quay lại&lt;br&gt;PENDING_CONFIRMATION để user xác nhận lại thay đổi" vertex="1">
          <mxGeometry height="250" width="560" x="780" y="3650" as="geometry" />
        </mxCell>
        <mxCell id="st10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F6E7;strokeColor=#4B8B3B;fontSize=11.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;10. CALENDAR&lt;/b&gt;  (2 khả năng — không gộp chung tên trạng thái)&lt;br&gt;&lt;br&gt;&lt;b&gt;A. Chỉ generate .ics (không tích hợp calendar thật):&lt;/b&gt;&lt;br&gt;CONFIRMED -&gt; xuất file .ics -&gt; &lt;b&gt;EXPORTED&lt;/b&gt;&lt;br&gt;(không gọi là CALENDAR_SYNCED — không có event thật&lt;br&gt;nào được tạo/ghi nhận ở phía calendar provider)&lt;br&gt;&lt;br&gt;&lt;b&gt;B. Có tích hợp Calendar API thật:&lt;/b&gt;&lt;br&gt;CONFIRMED -&gt; gọi API tạo event -&gt; &lt;b&gt;CALENDAR_SYNCED&lt;/b&gt;&lt;br&gt;Lưu calendar_event_id / event_uid ổn định&lt;br&gt;Hỗ trợ CREATE / UPDATE / CANCEL theo thay đổi issue&lt;br&gt;&lt;br&gt;Cả 2 trường hợp: mỗi task lưu external reference&lt;br&gt;issue_key/issue_id (+ calendar_event_id nếu có) — issue&lt;br&gt;Jira gốc đổi sau khi đã EXPORTED/CALENDAR_SYNCED thì&lt;br&gt;UPDATE lại đúng bản ghi cũ, KHÔNG tạo trùng mới" vertex="1">
          <mxGeometry height="330" width="560" x="780" y="3950" as="geometry" />
        </mxCell>
        <mxCell id="e0" edge="1" parent="1" source="src" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;" target="st1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="st1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;" target="st2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="st2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;" target="st3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="st3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;" target="st4label">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4a" edge="1" parent="1" source="st4a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="st5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4b" edge="1" parent="1" source="st4b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="st5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="st5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;" target="st6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
