<mxCell id="input_guard" value="&lt;b&gt;Input preflight&lt;/b&gt;&lt;br&gt;prompt-injection scan&lt;br&gt;secret / abusive request block&lt;br&gt;source + temporal clarification" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#7C3AED;fontColor=#3B0764;fontSize=13;" vertex="1" parent="lane_agent"><mxGeometry x="440" y="55" width="370" height="110" as="geometry"/></mxCell>
<mxCell id="tool_policy" value="&lt;b&gt;Tool policy + executor&lt;/b&gt;&lt;br&gt;strict schemas · impact allowlists&lt;br&gt;unknown / direct write fail closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#7C3AED;fontColor=#3B0764;fontSize=13;" vertex="1" parent="lane_agent"><mxGeometry x="850" y="60" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="sanitize" value="&lt;b&gt;Untrusted-content boundary&lt;/b&gt;&lt;br&gt;NFKC + hidden-control removal&lt;br&gt;injection / encoded payload redaction&lt;br&gt;evidence tags + context budget" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#7C3AED;fontColor=#3B0764;fontSize=13;" vertex="1" parent="lane_agent"><mxGeometry x="1250" y="50" width="380" height="120" as="geometry"/></mxCell>
<mxCell id="grounding" value="&lt;b&gt;Output grounding&lt;/b&gt;&lt;br&gt;evidence IDs + permission hook&lt;br&gt;grounded / uncertain / abstain / reject" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#7C3AED;fontColor=#3B0764;fontSize=13;" vertex="1" parent="lane_agent"><mxGeometry x="1690" y="60" width="370" height="100" as="geometry"/></mxCell>
<mxCell id="attachment_guard" value="&lt;b&gt;Attachment safety&lt;/b&gt;&lt;br&gt;MIME + byte cap · zip-bomb check&lt;br&gt;image verify · extraction timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#7C3AED;fontColor=#3B0764;fontSize=13;" vertex="1" parent="lane_agent"><mxGeometry x="440" y="260" width="370" height="100" as="geometry"/></mxCell>
<mxCell id="approval" value="&lt;b&gt;Authenticated write approval&lt;/b&gt;&lt;br&gt;server-stored proposal · HMAC signature&lt;br&gt;field provenance · OAuth write scope&lt;br&gt;request-derived idempotency IDs" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#5F4300;fontSize=13;" vertex="1" parent="lane_agent"><mxGeometry x="900" y="245" width="450" height="125" as="geometry"/></mxCell>
<mxCell id="public_boundary" value="&lt;b&gt;Public response boundary&lt;/b&gt;&lt;br&gt;SSE exposes semantic progress / tokens only&lt;br&gt;private analysis removed from stream result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#254D24;fontSize=13;" vertex="1" parent="lane_agent"><mxGeometry x="1660" y="260" width="420" height="100" as="geometry"/></mxCell>
<mxCell id="postgres" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;owner-keyed conversations / tasks / scopes&lt;br&gt;signed pending action in message extras" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;" vertex="1" parent="lane_data"><mxGeometry x="40" y="55" width="390" height="110" as="geometry"/></mxCell>
<mxCell id="token_store" value="&lt;b&gt;Connector token storage&lt;/b&gt;&lt;br&gt;Fernet-encrypted access / refresh tokens&lt;br&gt;server-side only" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;" vertex="1" parent="lane_data"><mxGeometry x="520" y="60" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="telemetry" value="&lt;b&gt;Telemetry + Prometheus&lt;/b&gt;&lt;br&gt;event-attribute allowlist · low-cardinality labels&lt;br&gt;guardrail / grounding / tool metrics&lt;br&gt;pseudonymous LLM user hash" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;" vertex="1" parent="lane_data"><mxGeometry x="970" y="45" width="410" height="120" as="geometry"/></mxCell>
<mxCell id="pii" value="&lt;b&gt;LangSmith privacy boundary&lt;/b&gt;&lt;br&gt;HMAC-tokenized email / phone&lt;br&gt;optional hide inputs + outputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;" vertex="1" parent="lane_data"><mxGeometry x="1510" y="60" width="390" height="100" as="geometry"/></mxCell>
<mxCell id="gaps" value="&lt;b&gt;Verified gaps / partial integration&lt;/b&gt;&lt;br&gt;1. Runtime auth is custom HS256 JWT while target architecture names Supabase Auth.  2. No executable RLS setup was found; app-level ownership/scope filters are the active boundary.&lt;br&gt;3. Generic build_context_pack(), HITLAuditLog / route_tool_call(), and MonitoringAlert are library/test surfaces, not wired into the conversation path.  4. Conversation retention is still TBD; the non-stream endpoint persists and returns analysis." style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1F;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="lane_gaps"><mxGeometry x="30" y="45" width="2060" height="100" as="geometry"/></mxCell>

