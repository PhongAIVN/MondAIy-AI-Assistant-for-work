<mxCell id="authorization" value="&lt;b&gt;Authorization&lt;/b&gt;&lt;br&gt;active-user / admin dependencies&lt;br&gt;conversation ownership returns 404" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#3D2447;fontSize=13;" vertex="1" parent="lane_api"><mxGeometry x="930" y="55" width="360" height="90" as="geometry"/></mxCell>
<mxCell id="oauth_state" value="&lt;b&gt;OAuth boundary&lt;/b&gt;&lt;br&gt;signed + expiring state / login code&lt;br&gt;tokens stay out of redirect URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#3D2447;fontSize=13;" vertex="1" parent="lane_api"><mxGeometry x="1450" y="55" width="400" height="90" as="geometry"/></mxCell>
