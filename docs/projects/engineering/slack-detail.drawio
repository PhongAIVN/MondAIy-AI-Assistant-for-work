        </mxCell>
        <mxCell id="e4b" edge="1" parent="1" source="st4b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="st5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="st5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;" target="st6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="st6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;" target="st7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="st7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;" target="st8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8d" edge="1" parent="1" source="st8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="dDrop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8r" edge="1" parent="1" source="st8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="dReview">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8k" edge="1" parent="1" source="st8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;" target="dKeep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9r" edge="1" parent="1" source="dReview" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#4B8B3B;" target="st9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9k" edge="1" parent="1" source="dKeep" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#4B8B3B;" target="st9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="st9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;" target="st10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ucLink1" edge="1" parent="1" source="uc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;strokeColor=#7B4FBF;fontSize=10;fontColor=#7B4FBF;" target="st2" value="timezone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ucLink2" edge="1" parent="1" source="uc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;strokeColor=#7B4FBF;fontSize=10;fontColor=#7B4FBF;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" target="st4a" value="slack_user_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rcLabel" parent="1" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#B8960C;align=left;" value="RULE CONFIG  (cross-cutting — cấu hình được, không hard-code)" vertex="1">
          <mxGeometry height="24" width="560" x="1400" y="1750" as="geometry" />
        </mxCell>
        <mxCell id="rc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E0;strokeColor=#B8960C;fontSize=11;fontFamily=Courier New;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="RULE_CONFIG&lt;br&gt;├── thresholds (giữ lại &gt;=35, fuzzy match &gt;=72%...)&lt;br&gt;├── scoring weights (mention/dm/thread_reply/&lt;br&gt;│&amp;#160;&amp;#160;&amp;#160;action/deadline/urgency/pinned/newsletter...)&lt;br&gt;├── deadline keyword patterns (regex thời gian&lt;br&gt;│&amp;#160;&amp;#160;&amp;#160;tương đối — QUAN TRỌNG hơn nguồn khác, xem st4b)&lt;br&gt;├── priority channel list (channel/DM nào ưu tiên&lt;br&gt;│&amp;#160;&amp;#160;&amp;#160;hơn, nếu cần override mặc định DM &gt; public)&lt;br&gt;├── reaction-question emoji list&lt;br&gt;├── action keywords&lt;br&gt;├── urgency keywords&lt;br&gt;├── system-generated subtype list&lt;br&gt;├── rate-limit tier giả định (internal/distributed —&lt;br&gt;│&amp;#160;&amp;#160;&amp;#160;xem risk1, cần xác nhận trước khi build)&lt;br&gt;└── grouping thresholds&lt;br&gt;&lt;br&gt;Có &lt;b&gt;rule_version&lt;/b&gt; — biết 1 decision được tạo ra&lt;br&gt;bởi phiên bản rule nào." vertex="1">
          <mxGeometry height="440" width="560" x="1400" y="1784" as="geometry" />
        </mxCell>
        <mxCell id="rcBracket" parent="1" style="text;html=1;fontSize=10;fontStyle=2;fontColor=#B8960C;align=left;" value="áp dụng cho bước 3, 4, 5, 7&#xa;(Hard Filter / Rules / Scoring / Dedup-Group)" vertex="1">
          <mxGeometry height="34" width="560" x="1400" y="2230" as="geometry" />
        </mxCell>
        <mxCell id="rcLink" edge="1" parent="1" source="rc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#B8960C;" target="st4label">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adLabel" parent="1" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#666666;align=left;" value="AUDIT / DEBUG  (cross-cutting — xuyên suốt bước 1-8)" vertex="1">
          <mxGeometry height="24" width="560" x="1400" y="2320" as="geometry" />
        </mxCell>
        <mxCell id="ad" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="Mỗi lần chạy (sync/run) ghi lại được:&lt;br&gt;&lt;br&gt;- Message nào được fetch (backfill hay real-time&lt;br&gt;  event), kết quả ingest (SUCCESS/SYNC_FAILED/&lt;br&gt;  EMPTY_RESULT)&lt;br&gt;- Message nào DROP / REVIEW / KEEP&lt;br&gt;- score + reasons[] + rule_version của từng message&lt;br&gt;- candidate task nào gộp từ message nào (references)&lt;br&gt;- sync/run ID, processing timestamp&lt;br&gt;&lt;br&gt;Mục tiêu: audit lại được toàn bộ quyết định của 1&lt;br&gt;lần đồng bộ mà không cần hỏi AI, không cần đọc code." vertex="1">
          <mxGeometry height="270" width="560" x="1490" y="2360" as="geometry" />
        </mxCell>
        <mxCell id="adLink" edge="1" parent="1" source="ad" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;strokeColor=#666666;" target="st8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="openLabel" parent="1" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#C0392B;align=left;" value="CÂU HỎI MỞ — CẦN QUYẾT ĐỊNH TRƯỚC KHI CHỐT SCOPE" vertex="1">
          <mxGeometry height="24" width="560" x="1400" y="2660" as="geometry" />
        </mxCell>
        <mxCell id="open1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C0392B;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="1. App Slack của mondaiy có được tính &amp;quot;internal&amp;quot; để giữ rate limit Tier 3 không? (xem risk1 — CHẶN thiết kế ingestion)&lt;br&gt;&lt;br&gt;2. Deadline suy luận từ text tự nhiên (không có due_date field) — độ tin cậy chấp nhận được ở mức nào trước khi hiện cho user? Có cần đánh dấu rõ &amp;quot;deadline suy luận, có thể sai&amp;quot; trên UI không?&lt;br&gt;&lt;br&gt;3. Phạm vi channel: fetch TẤT CẢ channel bot được add, hay chỉ channel user chọn (giống cơ chế chọn nguồn hiện có ở Jira/Gmail)? Ảnh hưởng trực tiếp consent/privacy.&lt;br&gt;&lt;br&gt;4. DM/private channel chứa nội dung nhạy cảm hơn email công việc — có cần review privacy/PRD riêng trước khi bật ingest DM không (khác hẳn mức độ nhạy cảm so với Jira issue)?&lt;br&gt;&lt;br&gt;5. Slack app phải qua App Directory review nếu muốn cài vào workspace không do mình quản trị — có nằm trong phạm vi pilot hiện tại không, hay chỉ tự cài vào 1 workspace nội bộ?" vertex="1">
          <mxGeometry height="420" width="560" x="1400" y="2696" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="slack-example" name="Vi du minh hoa">
    <mxGraphModel dx="1667" dy="733" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="etitle" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;" value="Ví dụ: 1 DM nhắc deadline đi qua đủ 10 bước pipeline (rule-base, DRAFT)" vertex="1">
          <mxGeometry height="26" width="1100" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="uc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#7B4FBF;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;CURRENT USER CONTEXT&lt;/b&gt;&lt;br&gt;&lt;br&gt;slack_user_id: U0PHONG01&lt;br&gt;team_id: T0MONDAIY&lt;br&gt;timezone: Asia/Ho_Chi_Minh" vertex="1">
          <mxGeometry height="110" width="260" x="1330" y="16" as="geometry" />
        </mxCell>
        <mxCell id="ex1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;1. INGESTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;event Events API: message.im&lt;br&gt;channel=D0MENTOR01&lt;br&gt;(DM với mentor)&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;kết quả = SUCCESS&lt;br&gt;1 message thô, ts=&lt;br&gt;1755230400.000100" vertex="1">
          <mxGeometry height="240" width="270" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ex2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;2. NORMALIZATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;message thô + timezone&lt;br&gt;(từ User Context)&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt; (schema chuẩn)&lt;br&gt;channel_type: im&lt;br&gt;text: &amp;quot;&amp;lt;@U0PHONG01&amp;gt; nhớ&lt;br&gt;nộp báo cáo tuần trước&lt;br&gt;5h chiều thứ Sáu nhé&amp;quot;&lt;br&gt;-&gt; parse mention thành&lt;br&gt;&amp;quot;@Phong nhớ nộp báo cáo&lt;br&gt;tuần trước 5h chiều thứ&lt;br&gt;Sáu nhé&amp;quot;&lt;br&gt;deep_link: chat.getPermalink" vertex="1">
          <mxGeometry height="340" width="270" x="330" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ex3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C0392B;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;3. HARD FILTER&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;subtype: (none, message&lt;br&gt;thường của user thật)&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;Không khớp điều kiện DROP&lt;br&gt;nào (không phải system/&lt;br&gt;automated subtype)&lt;br&gt;-&gt; KHÔNG bị DROP, đi tiếp" vertex="1">
          <mxGeometry height="240" width="270" x="620" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ex4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D97A2B;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;4. SLACK + COMMON RULES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;message đã qua Hard Filter&lt;br&gt;+ slack_user_id (User Context)&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt; (rule khớp)&lt;br&gt;MENTIONED_CURRENT_USER&lt;br&gt;DIRECT_MESSAGE (channel_type=im)&lt;br&gt;HAS_ACTION (&amp;quot;nộp&amp;quot;)&lt;br&gt;HAS_DEADLINE_INFERRED&lt;br&gt;(&amp;quot;5h chiều thứ Sáu&amp;quot;)" vertex="1">
          <mxGeometry height="320" width="270" x="910" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ex5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;5. SCORING&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;4 rule đã khớp ở bước 4&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;MENTIONED_CURRENT_USER +30&lt;br&gt;DIRECT_MESSAGE +15&lt;br&gt;HAS_ACTION +25&lt;br&gt;HAS_DEADLINE_INFERRED +25&lt;br&gt;&lt;br&gt;score = 95 (&gt;= ngưỡng 35&lt;br&gt;mặc định)" vertex="1">
          <mxGeometry height="240" width="270" x="1200" y="70" as="geometry" />
        </mxCell>
        <mxCell id="ex6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;6. EXTRACTION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;message DM, score=95&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;title (SUY RA): &amp;quot;Nộp báo&lt;br&gt;cáo tuần&amp;quot;&lt;br&gt;assignee: Phong (mention)&lt;br&gt;deadline (SUY LUẬN từ NLP&lt;br&gt;thời gian, quy đổi Asia/&lt;br&gt;Ho_Chi_Minh): thứ Sáu&lt;br&gt;tuần này, 17:00&lt;br&gt;evidence: &amp;quot;...nộp báo cáo&lt;br&gt;tuần trước 5h chiều thứ&lt;br&gt;Sáu nhé&amp;quot;" vertex="1">
          <mxGeometry height="440" width="270" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ex7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B5FA6;fontSize=10.5;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;7. DEDUP / GROUP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;message đã extract + toàn&lt;br&gt;bộ message khác trong&lt;br&gt;đợt sync này&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;Dedup: (channel_id, ts) duy&lt;br&gt;nhất, không trùng backfill/&lt;br&gt;event&lt;br&gt;Group: không thread reply&lt;br&gt;nào khác -&gt; 1 candidate&lt;br&gt;task, references =&lt;br&gt;[(D0MENTOR01, ts)]" vertex="1">
          <mxGeometry height="440" width="270" x="330" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ex8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EBFA;strokeColor=#7B4FBF;fontSize=10.5;fontFamily=Courier New;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;8. DECISION&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;candidate task, score=95&lt;br&gt;&lt;br&gt;&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;{&lt;br&gt;&amp;#160;score: 95,&lt;br&gt;&amp;#160;decision: &amp;quot;KEEP&amp;quot;,&lt;br&gt;&amp;#160;reasons: [&amp;quot;MENTIONED_CURRENT_USER&amp;quot;,&lt;br&gt;&amp;#160;&amp;#160;&amp;quot;DIRECT_MESSAGE&amp;quot;, &amp;quot;HAS_ACTION&amp;quot;,&lt;br&gt;&amp;#160;&amp;#160;&amp;quot;HAS_DEADLINE_INFERRED&amp;quot;],&lt;br&gt;&amp;#160;rule_version: &amp;quot;slack-rules-v1-draft&amp;quot;&lt;br&gt;}" vertex="1">
