# Copy to .env.local — KHÔNG commit .env.local
# Local hoặc frontend chạy trên máy riêng: gọi thẳng backend tương ứng.
VITE_API_URL=http://localhost:8000
# Production trên máy frontend riêng:
# VITE_API_URL=https://p004-api.duckdns.org
# Production Vercel (https://www.c3-app-004.io.vn): KHÔNG khai VITE_API_URL;
# vercel.json rewrite /api/* sang backend để request giữ same-origin.
# Link dashboard observability production (Vite injects at build time).
VITE_GRAFANA_URL=
VITE_PROMETHEUS_URL=
# Ép trang /run chạy bằng fixture cục bộ thay vì gọi backend. Để trống ở môi
# trường demo: khi bỏ trống, FE vẫn tự lùi về fixture nếu backend chưa có
# endpoint /runs, và luôn hiện băng cảnh báo màu vàng khi đang dùng dữ liệu giả.
# VITE_PIPELINE_MOCK=1
# VITE_API_URL=https://p004-api.duckdns.org
