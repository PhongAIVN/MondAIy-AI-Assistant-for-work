# Copy sang .env, KHÔNG commit .env
# Prefix WXT_ bắt buộc để WXT inline vào build (xem https://wxt.dev/guide/essentials/config/environment-variables)

# Base URL của API chính (services/api). Dùng cho host_permissions + mọi request.
WXT_API_BASE_URL=http://localhost:8000

# Base URL của web app — extension chỉ mở tab tới đây khi bấm icon hoặc bấm
# notification, không tự render UI riêng.
WXT_WEB_APP_URL=http://localhost:5173
