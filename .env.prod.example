# .env cho VPS production — copy thành .env cạnh docker-compose.prod.yml,
# điền giá trị thật. KHÔNG commit file .env thật lên git.

# ---- Image (điền đúng owner/repo GitHub, viết thường) ----
BACKEND_IMAGE=ghcr.io/OWNER/REPO-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/REPO-frontend:latest

# ---- Edge (optional profile: vm-edge) ----
# Production chính dùng Vercel cho frontend và minute_caddy trên VM để public
# backend. Service edge không chạy trong deploy mặc định; chỉ bật bằng
# `--profile vm-edge` khi cần test frontend container riêng trên cổng 8443.
CADDY_ADDR=p004-api.duckdns.org:8443
EDGE_BIND=0.0.0.0:8443
# Token của tài khoản DuckDNS đang sở hữu subdomain, lấy ở trang chủ duckdns.org
# sau khi đăng nhập. Chỉ có quyền sửa DNS, không phải secret của app.
DUCKDNS_API_TOKEN=

# Mode "đứng sau proxy khác" (proxy ngoài lo HTTPS, Caddy chạy HTTP thuần):
# đổi CADDY_ADDR là KHÔNG đủ — phải xoá hẳn khối `tls` trong
# client/web-app/Caddyfile rồi build lại image, nếu không Caddy vẫn bắt tay TLS
# và trả 400 cho mọi request HTTP.
# Mode "một mình một VPS": CADDY_ADDR=domain-thật (không kèm cổng), EDGE_BIND
# bỏ trống và sửa "ports" của service edge thành ["80:80", "443:443"].

# ---- Database ----
POSTGRES_USER=app
POSTGRES_PASSWORD=doi-cai-nay-thanh-mat-khau-manh
POSTGRES_DB=ai20k

# ---- Object storage ----
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PRESIGN_ENDPOINT=minio:9000

# ---- App ----
APP_ENV=production

# Optional XLM-R email classifier. Keep the token only in the VPS .env.
HF_MAIL_FILTER_ENABLED=false
HF_MAIL_FILTER_TOKEN=
HF_MAIL_FILTER_MODEL=DungND1107/modaiy_vin
HF_MAIL_FILTER_ENDPOINT=
HF_MAIL_FILTER_TIMEOUT_SECONDS=8
HF_MAIL_FILTER_MAX_CHARS=6000
HF_MAIL_FILTER_MIN_CONFIDENCE=0.80
HF_MAIL_FILTER_KEEP_LABELS=LABEL_1,keep,relevant,actionable,important,positive
HF_MAIL_FILTER_DROP_LABELS=LABEL_0,drop,irrelevant,spam,noise,negative

# Optional AnythingLLM-compatible Gmail Apps Script bridge (read-only).
# Keep the real URL/key/user id only in the VPS .env; never commit them.
ANYTHINGLLM_GMAIL_BRIDGE_ENABLED=false
ANYTHINGLLM_GMAIL_BRIDGE_URL=
ANYTHINGLLM_GMAIL_BRIDGE_API_KEY=
ANYTHINGLLM_GMAIL_BRIDGE_USER_ID=
ANYTHINGLLM_GMAIL_BRIDGE_TIMEOUT_SECONDS=8
ANYTHINGLLM_GMAIL_BRIDGE_MAX_RESULTS=20
# Origin frontend Vercel thật. Nếu có nhiều preview/domain thì phân cách bằng dấu phẩy.
CORS_ORIGINS=https://your-p004-frontend.vercel.app
# Chuỗi ngẫu nhiên dài, KHÁC giá trị mẫu — ký JWT access/refresh token.
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# URL công khai của chính backend này — dùng dựng redirect_uri gửi cho
# Discord/Google, phải khớp y hệt giá trị đã đăng ký trên từng dev console,
# Sai một ký tự là OAuth trả redirect_uri_mismatch.
APP_PUBLIC_URL=https://p004-api.duckdns.org
# Origin frontend thật, không có dấu / cuối. Bot dùng để mở màn hình kết nối.
WEB_APP_PUBLIC_URL=https://www.c3-app-004.io.vn
# Phải khớp scheme trong apps/mobile/app.json và callback Expo WebBrowser.
MOBILE_APP_REDIRECT_URI=mondaiy://auth/google
# iOS bundle ID đã bật Sign in with Apple trong Apple Developer.
APPLE_CLIENT_ID=com.mondaiy.product

# ---- Observability ----
PROMETHEUS_RETENTION=15d
PROMETHEUS_ROOT_URL=https://p004-api.duckdns.org/prometheus/
GRAFANA_ROOT_URL=https://p004-api.duckdns.org/grafana/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Fine-grained PAT chỉ cần đọc Actions/metadata của repository P-004. Secret
# này chỉ đặt trong /opt/p-004/.env trên VM, tuyệt đối không commit giá trị thật.
GITHUB_ACTIONS_EXPORTER_TOKEN=

# ---- LangSmith (trace agent, xem trong Grafana) ----
# Backend/worker đọc ba biến dưới để đẩy trace lên LangSmith. Tên LANGSMITH_*
# là tên hiện hành; SDK vẫn chấp nhận LANGCHAIN_* cũ, đừng khai cả hai kẻo lệch.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=p004-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Salt bí mật dùng HMAC để cùng một định danh có cùng token trong trace. Bắt
# buộc khi redaction bật; sinh riêng cho từng môi trường, không commit giá trị.
LANGSMITH_PII_REDACTION_ENABLED=true
LANGSMITH_PII_SALT=
# Kill switch bỏ toàn bộ payload nhưng vẫn giữ trace timing/metadata.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
# Cùng một key được Grafana dùng lại cho datasource "P-004 LangSmith" để đọc
# ngược trace về dashboard. Key này đọc được toàn bộ workspace LangSmith, nên ai
# vào được Grafana admin coi như đọc được trace — cấp tài khoản Viewer cho admin
# khác thay vì chia sẻ key.
LANGSMITH_API_KEY=

# ---- Frontend build-time observability links ----
# These are GitHub Actions repository variables (Settings → Secrets and
# variables → Actions → Variables), not runtime variables consumed by the VM.
# Frontend image build trong CI dành cho máy frontend riêng, nên gọi backend
# public trực tiếp. Bản Vercel build riêng và để biến này trống vì vercel.json
# rewrite /api/* sang backend.
# VITE_API_URL=https://p004-api.duckdns.org
# VITE_GRAFANA_URL=https://grafana.example.com
# VITE_PROMETHEUS_URL=https://prometheus.example.com

# Fernet key (base64, 32 byte) mã hoá token của dịch vụ đã kết nối trước khi
# lưu DB. Đổi key là mọi connection đang có hết giải mã được.
# Tạo bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Capacity guards ----
REDIS_URL=redis://redis:6379/0
MAX_SYNC_SOURCES=3
MAX_SYNC_RANGE_DAYS=31
MAX_CONCURRENT_RUNS=3
MAX_RUNS_PER_USER=1
MAX_TOTAL_LLM_BATCHES_PER_RUN=20
MAX_LLM_BATCHES_PER_RUN=1
RUN_CLAIM_TIMEOUT_MINUTES=30
WORKER_POLL_SECONDS=1
SSE_POLL_SECONDS=0.5
LLM_QUESTIONS_PER_DAY=10

# ---- LLM ----
OPENAI_API_KEY=

# Nhúng chunk cho truy hồi (src/services/retrieval.py). Thiếu key thì nhánh
# vector im lặng rỗng, chỉ còn FTS.
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=llama-3.1-8b-instant
LLM_PROVIDERS=openrouter,groq
# Bật sau khi staging smoke-test đã xác nhận function calling của work candidates.
LLM_ROUTING_ENABLED=false
SMALL_TALK_CANDIDATES=openrouter:inclusionai/ling-3.0-tiny:free,groq:llama-3.1-8b-instant
WORK_TOOL_CANDIDATES=openrouter:inclusionai/ling-3.0-tiny:free,groq:llama-3.1-8b-instant
WORK_RESPONSE_CANDIDATES=openrouter:inclusionai/ling-3.0-tiny:free,groq:llama-3.1-8b-instant
PAID_FALLBACK_ENABLED=false
LLM_CANDIDATE_MAX_ATTEMPTS=1
# Tavily chỉ bật khi đã chấp thuận web search cho production.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
# Đổi model nhúng là phải nhúng lại toàn bộ: pgvector khoá số chiều theo cột.
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_BATCH_SIZE=32

# Truy hồi memory dài hạn (ADR-006). Nhánh vector chỉ chạy trên PostgreSQL có
# extension vector; tắt cờ này là đường rollback, hệ thống quay về khớp từ khoá.
MEMORY_SEMANTIC_RECALL_ENABLED=true
MEMORY_EMBEDDING_BATCH_LIMIT=16

# Các biến OAuth (Discord/Google/Telegram) xem .env.example ở root nếu bật
# tính năng connections.


SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
