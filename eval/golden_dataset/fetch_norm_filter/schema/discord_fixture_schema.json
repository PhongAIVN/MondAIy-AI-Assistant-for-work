{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DiscordFixture",
  "anyOf": [
    {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "channel_id",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "channel_id": {
            "type": "string"
          },
          "guild_id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "edited_timestamp": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": "object",
            "required": [
              "id",
              "username"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "discriminator": {
                "type": "string"
              }
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "filename"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "filename": {
                  "type": "string"
                },
                "size": {
                  "type": "integer"
                },
                "url": {
                  "type": "string"
                },
                "content_type": {
                  "type": "string"
                }
              }
            }
          },
          "mentions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "username": {
                  "type": "string"
                }
              }
            }
          },
          "referenced_message": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "error_response"
      ],
      "properties": {
        "error_response": {
          "type": "object",
          "required": [
            "status_code",
            "message"
          ],
          "properties": {
            "status_code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
