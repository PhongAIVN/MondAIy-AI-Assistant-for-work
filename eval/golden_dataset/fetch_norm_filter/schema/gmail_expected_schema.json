{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GmailExpected",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "error"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_id",
          "provider",
          "text",
          "sent_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "thread_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "author_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "author_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_self": {
            "type": "boolean"
          },
          "is_dm": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "sent_at": {
            "type": "string"
          },
          "deep_link": {
            "type": [
              "string",
              "null"
            ]
          },
          "capture_mode": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "filename",
                "mimeType",
                "sizeBytes"
              ],
              "properties": {
                "filename": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "sizeBytes": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "error_info": {
      "type": "string"
    }
  }
}
